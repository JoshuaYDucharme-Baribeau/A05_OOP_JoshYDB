<Window x:Class="notepadApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:notepadApplication"
        mc:Ignorable="d"
        Name="NotepadWindow"
        Title="Untitled" MinHeight="110" MinWidth="200" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <!--1 column, rendundant but allows for expansion later-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!--1 rows, rendundant but allows for expansion later-->
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        
        <!--content of grid-->
        <Menu VerticalAlignment="Top" Height="20">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="mnu_newDoc"></MenuItem>
                <MenuItem Header="_Open" Click="mnu_open"></MenuItem>
                <MenuItem Header="_Save" Click="mnu_save"></MenuItem>
                <MenuItem Header="Save _As" Click="mnu_saveAs"></MenuItem>
                <MenuItem Header="E_xit" Click="mnu_exit_app"></MenuItem>
            </MenuItem>
            
            <MenuItem Header="_View">
                <MenuItem Name="element_mnu_wrap" Header="_Wrap Text [Off]" Click="mnu_WrapText" IsCheckable="True" IsChecked="False"></MenuItem>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="mnu_about"></MenuItem>
            </MenuItem>
        </Menu>
        
        <!--
            NOTE: I was going to use a rich textbox, but it does not natively support 
            disabling text wrap, which is a requirement. I have opted for default textbox.
        -->
            <TextBox 
                Name="WorkingTextArea"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch" 
                Margin="0,20,0,20" 
                AcceptsReturn="True"
                AcceptsTab="True"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                
                TextWrapping="NoWrap"
                
                TextChanged="WorkArea_TextChanged"
            ></TextBox>
        <!--status bar-->
        <StatusBar Name="DocumentStatus" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Width="auto" Height="20" Background="LightGray" >

            <TextBlock Name ="StatusText" HorizontalAlignment="Stretch" Width="auto" Text="Chars: 0" ><!--dynamic count from the work area's properties?--></TextBlock>
            
        </StatusBar>
        
    </Grid>
</Window>
